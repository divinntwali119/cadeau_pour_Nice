# ============================================================
# FICHIER D'EXEMPLE .env — Église Smyrne (5e CELPA)
# ============================================================
# Copiez ce fichier vers .env et adaptez les valeurs :
#   cp .env.example .env
#
# IMPORTANT : NE JAMAIS COMMITTER LE FICHIER .env DANS GIT !
# ============================================================

# ─── Configuration Django ──────────────────────────────────
# Générez une clé secrète avec :
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=votre_cle_secrete_longue_et_aleatoire_ici_50_caracteres_min

# False en production, True uniquement en développement local
DEBUG=False

# Domaines autorisés séparés par des virgules (sans https://)
# Exemple: smyrne-rdc.com,www.smyrne-rdc.com,127.0.0.1
ALLOWED_HOSTS=smyrne-rdc.com,www.smyrne-rdc.com

# ─── Base de données ───────────────────────────────────────
# SQLite (développement) :
# DATABASE_URL=sqlite:///db.sqlite3
#
# PostgreSQL (production recommandée) :
# DATABASE_URL=postgresql://utilisateur:motdepasse@localhost:5432/smyrne_db
DATABASE_URL=sqlite:///db.sqlite3

# ─── Fichiers Statiques & Médias ───────────────────────────
STATIC_URL=/static/
MEDIA_URL=/media/

# ─── Email (Optionnel pour notifications et formulaires) ──
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=contact@smyrne-rdc.com
# EMAIL_HOST_PASSWORD=votre_mot_de_passe_application
# DEFAULT_FROM_EMAIL=contact@smyrne-rdc.com

# ─── Django Axes (Sécurité anti-brute-force) ───────────────
# Mettre à False en production pour bloquer les attaques
AXES_NEVER_LOCKOUT_WHITELIST=False
